.DS_Store
node_modules/

# Local Apify token for running fetch.mjs by hand. Ignored so a secret can
# never be committed; in CI the token comes from the APIFY_TOKEN repo secret.
.env.local

# Local scratch copy of the data store. In CI this lives on the orphan `data`
# branch; locally it is regenerated by scripts/fetch.mjs and never committed
# to `main`.
/store/
/_site/
*.tmp
